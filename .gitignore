# Generated data artifacts (regenerate by running the pipeline)
raw_data_architecture/data/*
!raw_data_architecture/data/.gitkeep
data_cleaning/data/*
!data_cleaning/data/.gitkeep
dashboard/output/*
!dashboard/output/.gitkeep
outputs/*
!outputs/.gitkeep
*.csv
*.parquet

# Proprietary / local material and large source artifacts — kept out of the repo.
# Reference PDFs, the conversion workbook, and any lookup tables derived from
# them live under local/ and are never committed.
local/
*.pdf
*.xlsx

# Personal agent-context overrides (CLAUDE.md itself is committed)
CLAUDE.local.md

# Narrow exception to the blanket *.csv rule above: the per-fix Asset-sheet
# snapshots that let a reviewer see which fix moved which number. These are our
# own model outputs (10 rows), not source material -- no grid, no lookup table,
# nothing derived from local/ beyond a single TTC PD per company, which the
# paper itself publishes in Tables 13-14. Everything else under
# docs/reconciliation/ stays ignored: the peer workbook embeds the proprietary
# TTC/PIT/RS/SP sheets and must never be committed.
!docs/reconciliation/history/
!docs/reconciliation/history/*.csv

# Narrow exception to the blanket *.xlsx rule: frozen deliverables. These are
# our own generated workbooks (README/Ratings/Asset/validation sheets), not
# local/ material -- no grid, no lookup table. Archived beside a DIFF.md so a
# reviewer can see what moved between frozen versions.
!docs/deliverables/
!docs/deliverables/*.xlsx

# Narrow exception: the small CSVs behind docs/figures/*.svg -- our own
# computed outputs (interval widths, rank fractions, recorded sweep letters),
# committed so the figures regenerate deterministically from committed data.
!docs/figures/data/
!docs/figures/data/*.csv

# Universe-run analysis outputs (taxonomy, distributions) -- our own computed
# results, small, committed for the record.
!docs/reconciliation/universe/
!docs/reconciliation/universe/*.csv

# Validation-study inputs and outputs (sourced agency ratings, computed
# correlations) -- committed for the record; SVGs are not csv-blocked.
!docs/analysis/
!docs/analysis/*.csv
!docs/analysis/data/
!docs/analysis/data/*.csv

# Golden files for the workbook tests: our own computed outputs, tiny.
!tests/golden/
!tests/golden/*.csv

# Acquisition cache (data/cache/): regenerated by running; ignored except a
# small committed fixture subset (the original 10-name universe + rates) so
# the demo and the test suite run offline on a fresh clone.
data/cache/*
!data/cache/_rates/
!data/cache/_rates/**
!data/cache/COST/
!data/cache/COST/**
!data/cache/KO/
!data/cache/KO/**
!data/cache/DELL/
!data/cache/DELL/**
!data/cache/ORCL/
!data/cache/ORCL/**
!data/cache/PNC/
!data/cache/PNC/**
!data/cache/WMT/
!data/cache/WMT/**
!data/cache/INTU/
!data/cache/INTU/**
!data/cache/AMZN/
!data/cache/AMZN/**
!data/cache/T/
!data/cache/T/**
!data/cache/KHC/
!data/cache/KHC/**
# TM: regression fixture for the reporting-currency gate (JPY statements,
# USD prices -- the company that made the unit mismatch loud).
!data/cache/TM/
!data/cache/TM/**

# macOS
.DS_Store

# Python
.coverage
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Stray legacy output dir (branch uses dashboard/output/)
/output/
