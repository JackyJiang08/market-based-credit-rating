# Generated data artifacts (regenerate by running the pipeline)
raw_data_architecture/data/*
!raw_data_architecture/data/.gitkeep
data_cleaning/data/*
!data_cleaning/data/.gitkeep
dashboard/output/*
!dashboard/output/.gitkeep
outputs/*
!outputs/.gitkeep
*.csv
*.parquet

# Proprietary / local material and large source artifacts — kept out of the repo.
# Reference PDFs, the conversion workbook, and any lookup tables derived from
# them live under local/ and are never committed.
local/
*.pdf
*.xlsx

# Personal agent-context overrides (CLAUDE.md itself is committed)
CLAUDE.local.md

# Narrow exception to the blanket *.csv rule above: the per-fix Asset-sheet
# snapshots that let a reviewer see which fix moved which number. These are our
# own model outputs (10 rows), not source material -- no grid, no lookup table,
# nothing derived from local/ beyond a single TTC PD per company, which the
# paper itself publishes in Tables 13-14. Everything else under
# docs/reconciliation/ stays ignored: the peer workbook embeds the proprietary
# TTC/PIT/RS/SP sheets and must never be committed.
!docs/reconciliation/history/
!docs/reconciliation/history/*.csv

# Narrow exception to the blanket *.xlsx rule: frozen deliverables. These are
# our own generated workbooks (README/Ratings/Asset/validation sheets), not
# local/ material -- no grid, no lookup table. Archived beside a DIFF.md so a
# reviewer can see what moved between frozen versions.
!docs/deliverables/
!docs/deliverables/*.xlsx

# macOS
.DS_Store

# Python
.coverage
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Stray legacy output dir (branch uses dashboard/output/)
/output/
